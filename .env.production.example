# Copy to `.env` ON THE SERVER (never commit it) and fill in the real values.
# Generate the secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=bookyourtickets.online,www.bookyourtickets.online
DJANGO_CSRF_TRUSTED_ORIGINS=https://bookyourtickets.online,https://www.bookyourtickets.online

# Absolute paths on the shared host. Replace CPANELUSER with your cPanel
# username. Both MUST stay outside public_html — anything inside the docroot is
# downloadable, and that includes the SQLite database.
DJANGO_DB_PATH=/home/CPANELUSER/guestlink/db.sqlite3
DJANGO_STATIC_ROOT=/home/CPANELUSER/guestlink/staticfiles
DJANGO_MEDIA_ROOT=/home/CPANELUSER/guestlink/media

# Leave at 1: Django serves /media/ itself. Passenger on cPanel does not
# reliably hand uploaded files to Apache.
DJANGO_SERVE_MEDIA=1

# Leave off: force HTTPS in public_html/.htaccess instead. Enabling this
# without a trustworthy X-Forwarded-Proto causes a redirect loop.
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_TRUST_FORWARDED_PROTO=0
# Raise to 31536000 only after HTTPS is confirmed stable for a few days.
DJANGO_HSTS_SECONDS=0

# --- WhatsApp Cloud API ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_ACCESS_TOKEN=
# Must match exactly what you type into Meta's webhook form. Use a long random
# string, not the local placeholder.
WHATSAPP_VERIFY_TOKEN=
# Keep 1 until the first live smoke test, then flip to 0.
WHATSAPP_DRY_RUN=1

# --- Host / apartment ---
HOST_NAME=Joaquin
HOST_APARTMENT_LABEL=Reef
# Path encoded in the printed QR cards. Do not change without reprinting them.
APARTMENT_SLUG=the-reef-401

# --- Anthropic (optional; keyword fallback without it) ---
ANTHROPIC_API_KEY=
