# Django
DJANGO_SECRET_KEY=replace-me-in-real-env
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# WhatsApp Cloud API (fill when number ready)
WHATSAPP_PHONE_NUMBER_ID=          # Meta-internal ID used to send via Cloud API
WHATSAPP_BUSINESS_NUMBER=          # E.164 digits only (e.g. 18091234567) — used in wa.me deep links
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=local-verify-token
WHATSAPP_DRY_RUN=1

# Host (the owner of the apartment / single-tenant for v1)
HOST_NAME=Joaquin
HOST_APARTMENT_LABEL=Reef

# Anthropic (optional - classifier falls back to keyword matching without it)
ANTHROPIC_API_KEY=
